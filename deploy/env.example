# /etc/immich-eye/env — installed mode 640 root:<service user>
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY_FILE=/etc/immich-eye/api-key
STATE_DB=/var/lib/immich-eye/state.db
DESERTANT_BIN=/home/YOURUSER/.local/bin/desertant
PATH=/home/YOURUSER/.local/bin:/usr/local/bin:/usr/bin:/bin
TAG_PREFIX=eye
BATCH=24
PAGE_SIZE=200
MAX_SCENE_TAGS=8
DRY_RUN=0
# Optional: Uptime Kuma push monitor URL for this job
# KUMA_PUSH_URL=https://uptime-kuma.example.com/api/push/XXXXXXXX
